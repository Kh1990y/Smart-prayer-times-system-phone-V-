{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "rtl": true,
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${dayName}",
              "wrap": true,
              "weight": "Bolder",
              "size": "Medium"
            },
            {
              "type": "TextBlock",
              "text": "${dateH}",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "${city}",
              "wrap": true,
              "size": "Small",
              "color": "Accent",
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${dateG}",
              "wrap": true,
              "size": "Small",
              "isSubtle": true,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "accent",
      "spacing": "Small",
      "items": [
        {
          "type": "TextBlock",
          "text": "الصلاة القادمة: ${nextName} — ${nextTime}",
          "wrap": true,
          "weight": "Bolder",
          "horizontalAlignment": "Center"
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Small",
      "items": [
        {
          "type": "ColumnSet",
          "$data": "${rows}",
          "style": "${if(isNext, 'emphasis', 'default')}",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${name}",
                  "wrap": true,
                  "weight": "${if(isNext, 'Bolder', 'Default')}",
                  "color": "${if(isNext, 'Accent', 'Default')}",
                  "isSubtle": "${past}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${time}",
                  "wrap": true,
                  "weight": "Bolder",
                  "color": "${if(isNext, 'Accent', 'Default')}",
                  "isSubtle": "${past}",
                  "horizontalAlignment": "Left"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${dhikr}",
      "wrap": true,
      "size": "Small",
      "isSubtle": true,
      "horizontalAlignment": "Center",
      "spacing": "Medium"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "فتح التطبيق",
      "verb": "open"
    }
  ]
}